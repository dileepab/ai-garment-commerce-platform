{
  "name": "platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:migrate:sqlite-to-postgres": "node scripts/migrate-sqlite-to-postgres.js",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "check:meta": "node scripts/check-meta-subscription.js",
    "test:chat": "npm run build && node scripts/chat-regression-tests.js",
    "test:access-control": "node --test --experimental-strip-types --no-warnings scripts/access-control.test.ts",
    "test:brand-context": "node --test --experimental-strip-types --no-warnings scripts/brand-context.test.ts",
    "test:analytics": "node scripts/analytics-helpers.test.js",
    "test:bot-insights": "node scripts/bot-insights.test.js",
    "test:bot-training": "node scripts/bot-training.test.js",
    "test:contact-profile": "node --test --experimental-strip-types --no-warnings scripts/contact-profile.test.ts",
    "test:meta-profile": "node --test --experimental-strip-types --no-warnings scripts/meta-profile.test.ts",
    "test:retention": "node --test --experimental-strip-types --no-warnings scripts/retention-automation.test.ts",
    "test:support-inbox": "node --test --experimental-strip-types --no-warnings scripts/support-inbox.test.ts",
    "test:fulfillment": "node --test --experimental-strip-types --no-warnings scripts/fulfillment.test.ts",
    "test:variant-availability": "node --test --experimental-strip-types --no-warnings scripts/variant-availability.test.ts",
    "test:whatsapp": "node --test --experimental-strip-types --no-warnings scripts/whatsapp-normalize.test.ts scripts/meta-webhook-signature.test.ts scripts/whatsapp-registration.test.ts",
    "test:meta-catalog-feed": "node --test --experimental-strip-types --no-warnings scripts/meta-catalog-feed.test.ts",
    "test:meta-catalog": "node --test --experimental-strip-types --no-warnings scripts/meta-catalog-feed.test.ts scripts/meta-catalog-batch.test.ts",
    "test:tiktok": "node --test --experimental-strip-types --no-warnings scripts/tiktok-security.test.ts scripts/tiktok-webhook-signature.test.ts scripts/tiktok-normalize.test.ts scripts/tiktok-api.test.ts scripts/tiktok-account-api.test.ts scripts/tiktok-config.test.ts scripts/tiktok-account-config.test.ts",
    "cleanup:conversation": "node scripts/prune-conversation-data.js",
    "cleanup:test-data": "node scripts/cleanup-production-test-data.js",
    "reset:chat": "node scripts/reset-dev-chat-data.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@google/genai": "^1.49.0",
    "@prisma/client": "^5.22.0",
    "@vercel/blob": "^2.3.3",
    "next": "16.2.3",
    "next-auth": "^5.0.0-beta.31",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
